# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: groq | openai | gemini | anthropic (Ví dụ Groq: openai/gpt-oss-120b, qwen/qwen3.8-27b, openai/gpt-oss-20b)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# Generation providers (điền API key tương ứng với LLM_PROVIDER bạn chọn)
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: gemini | openai | sentence_transformers
# (Lưu ý: Groq không cung cấp endpoint embedding. Dùng Gemini (free tier) hoặc OpenAI hoặc sentence_transformers chạy local)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=
